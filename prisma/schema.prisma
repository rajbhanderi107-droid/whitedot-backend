generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES
  OPERATIONS
  VIEWER
  EMPLOYEE
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
  WFH
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  FREELANCE
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  PROBATION
  RESIGNED
  TERMINATED
}

enum EmployeeTaskStage {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum LeaveType {
  ANNUAL
  SICK
  CASUAL
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum AnnouncementAudience {
  ALL
  DEPARTMENT
}

enum CompanyStatus {
  LEAD
  ACTIVE_CLIENT
  INACTIVE
  BLACKLISTED
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum QuoteStatus {
  NEW
  UNDER_REVIEW
  NEED_MORE_INFO
  QUOTED
  NEGOTIATION
  APPROVED
  REJECTED
  CLOSED
}

enum SampleStatus {
  REQUESTED
  APPROVED
  REJECTED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  MISSED
  CANCELLED
}

enum DocumentCategory {
  BROCHURE
  TECHNICAL_DATASHEET
  SUSTAINABILITY_REPORT
  CASE_STUDY
  CLIENT_DOCUMENT
  INTERNAL
}

enum WebsiteSettingType {
  TEXT
  NUMBER
  BOOLEAN
  JSON
  URL
  EMAIL
}

enum ActivityEntityType {
  USER
  COMPANY
  INQUIRY
  QUOTE_REQUEST
  SAMPLE_REQUEST
  CALCULATOR_SUBMISSION
  DOCUMENT
  WEBSITE_SETTING
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  LEAD
  QUOTE
  SAMPLE
  FOLLOW_UP
}

// ─── Models ──────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Employee profile (digital office)
  jobTitle   String?
  department String?
  phone      String?

  // Security dome — Layer 3: brute-force lockout
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Relations
  assignedInquiries Inquiry[]            @relation("AssignedInquiries")
  assignedQuotes    QuoteRequest[]       @relation("AssignedQuotes")
  createdNotes      AdminNote[]          @relation("NoteCreator")
  assignedFollowUps FollowUpTask[]       @relation("AssignedFollowUps")
  uploadedDocuments DocumentAsset[]      @relation("DocumentUploader")
  updatedSettings   WebsiteSetting[]     @relation("SettingUpdater")
  activityLogs      ActivityLog[]
  notifications     Notification[]
  passwordResets    PasswordResetToken[]
  revokedTokens     RevokedToken[]
  approvalsCreated  Approval[]           @relation("ApprovalCreator")
  approvalsDecided  Approval[]           @relation("ApprovalDecider")
  workflowsCreated  Workflow[]           @relation("WorkflowCreator")
  attendanceDays    AttendanceDay[]
  locationPings     LocationPing[]
  employeeProfile   EmployeeProfile?
  workTasks         WorkTask[]
  leaveRequests     LeaveRequest[]
  departmentsHeaded Department[]         @relation("DeptHead")
  reviewsReceived   PerformanceReview[]  @relation("ReviewSubject")
  reviewsAuthored   PerformanceReview[]  @relation("ReviewAuthor")
  goals             Goal[]
  onboardingTasks   OnboardingTask[]
  payslips          Payslip[]
  announcements     Announcement[]       @relation("AnnouncementAuthor")

  @@index([email])
  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

model Company {
  id            String        @id @default(cuid())
  companyName   String
  industry      String?
  contactPerson String?
  email         String?
  phone         String?
  website       String?
  city          String?
  state         String?
  country       String?       @default("India")
  address       String?
  gstNumber     String?
  status        CompanyStatus @default(LEAD)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  inquiries             Inquiry[]
  quoteRequests         QuoteRequest[]
  sampleRequests        SampleRequest[]
  calculatorSubmissions CalculatorSubmission[]
  adminNotes            AdminNote[]
  followUpTasks         FollowUpTask[]
  documents             DocumentAsset[]

  @@index([email])
  @@index([status])
  @@index([companyName])
  @@index([createdAt])
}

model Inquiry {
  id            String        @id @default(cuid())
  name          String
  email         String
  phone         String?
  companyName   String?
  designation   String?
  city          String?
  country       String?
  industry      String?
  inquiryType   String?
  message       String?
  sourcePage    String?
  status        InquiryStatus @default(NEW)
  priority      Priority      @default(MEDIUM)
  internalNotes String?
  followUpDate  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  assignedTo    User?          @relation("AssignedInquiries", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId  String?
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId     String?
  adminNotes    AdminNote[]
  followUpTasks FollowUpTask[]

  @@index([email])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([companyId])
  @@index([createdAt])
}

model QuoteRequest {
  id                  String      @id @default(cuid())
  contactPerson       String
  email               String
  phone               String?
  productCategory     String?
  currentMaterial     String?
  currentPlasticGrade String?
  monthlyQuantity     String?
  targetApplication   String?
  strengthRequirement String?
  foodContactRequired Boolean?
  colorRequirement    String?
  sustainabilityGoal  String?
  expectedPriceRange  String?
  message             String?
  status              QuoteStatus @default(NEW)
  priority            Priority    @default(MEDIUM)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // Relations
  assignedTo    User?          @relation("AssignedQuotes", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId  String?
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId     String?
  adminNotes    AdminNote[]
  followUpTasks FollowUpTask[]

  @@index([email])
  @@index([status])
  @@index([assignedToId])
  @@index([companyId])
  @@index([createdAt])
}

model SampleRequest {
  id                    String       @id @default(cuid())
  contactPerson         String
  email                 String
  phone                 String?
  requestedMaterialType String?
  application           String?
  quantity              String?
  deliveryAddress       String?
  courierTracking       String?
  status                SampleStatus @default(REQUESTED)
  remarks               String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // Relations
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId     String?
  adminNotes    AdminNote[]
  followUpTasks FollowUpTask[]

  @@index([email])
  @@index([status])
  @@index([companyId])
  @@index([createdAt])
}

model CalculatorSubmission {
  id                         String   @id @default(cuid())
  companyName                String?
  contactPerson              String?
  email                      String?
  phone                      String?
  plasticType                String?
  currentGrade               String?
  currentQuantity            String?
  limexReplacementPercentage Float?
  estimatedCostSaving        Float?
  estimatedPlasticReduction  Float?
  estimatedCo2Impact         Float?
  assumptionsUsed            Json?
  convertedToLead            Boolean  @default(false)
  createdAt                  DateTime @default(now())

  // Relations
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  @@index([email])
  @@index([companyId])
  @@index([createdAt])
}

model AdminNote {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  createdBy       User           @relation("NoteCreator", fields: [createdById], references: [id])
  createdById     String
  company         Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId       String?
  inquiry         Inquiry?       @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  inquiryId       String?
  quoteRequest    QuoteRequest?  @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  quoteRequestId  String?
  sampleRequest   SampleRequest? @relation(fields: [sampleRequestId], references: [id], onDelete: SetNull)
  sampleRequestId String?
}

model FollowUpTask {
  id          String         @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime
  status      FollowUpStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  assignedTo      User           @relation("AssignedFollowUps", fields: [assignedToId], references: [id])
  assignedToId    String
  company         Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId       String?
  inquiry         Inquiry?       @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  inquiryId       String?
  quoteRequest    QuoteRequest?  @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  quoteRequestId  String?
  sampleRequest   SampleRequest? @relation(fields: [sampleRequestId], references: [id], onDelete: SetNull)
  sampleRequestId String?

  @@index([status])
  @@index([assignedToId])
  @@index([dueDate])
}

model DocumentAsset {
  id          String           @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  fileType    String?
  fileSize    Int?
  category    DocumentCategory @default(INTERNAL)
  isPublic    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  uploadedBy   User     @relation("DocumentUploader", fields: [uploadedById], references: [id])
  uploadedById String
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId    String?

  @@index([category])
  @@index([companyId])
}

model WebsiteSetting {
  id          String             @id @default(cuid())
  key         String             @unique
  value       String
  type        WebsiteSettingType @default(TEXT)
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Relations
  updatedBy   User?   @relation("SettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById String?
}

model ActivityLog {
  id         String             @id @default(cuid())
  action     String
  entityType ActivityEntityType
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime           @default(now())

  // Relations
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  @@index([entityType])
  @@index([userId])
  @@index([createdAt])
}

// Security dome — Layer 3: token blacklist (revoked JTIs)
model RevokedToken {
  id        String   @id @default(cuid())
  jti       String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  @@index([jti])
  @@index([expiresAt])
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ─── Portal enums ─────────────────────────────────

enum AutomationMode {
  OFF
  DRAFT
  APPROVAL
  AUTO
  LOCKDOWN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalRisk {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentSeverity {
  SEV0
  SEV1
  SEV2
  SEV3
  SEV4
}

enum IncidentStage {
  DETECTED
  TRIAGE
  CONTAINED
  INVESTIGATING
  FIXING
  RECOVERING
  RESOLVED
}

enum SecurityEventKind {
  AUTH_FAILURE
  RATE_LIMITED
  VALIDATION_REJECTED
  LOCKDOWN_BLOCK
}

// ─── Portal models ────────────────────────────────

model PortalState {
  id             String         @id @default("singleton")
  automationMode AutomationMode @default(OFF)
  emergencyStop  Boolean        @default(false)
  updatedAt      DateTime       @updatedAt
}

model PortalAutomation {
  id        String         @id
  enabled   Boolean        @default(false)
  mode      AutomationMode @default(OFF)
  updatedAt DateTime       @updatedAt
}

model PortalAiAgent {
  id        String         @id
  enabled   Boolean        @default(false)
  mode      AutomationMode @default(OFF)
  updatedAt DateTime       @updatedAt
}

model PortalIntegration {
  id          String   @id
  connected   Boolean  @default(false)
  environment String   @default("sandbox")
  updatedAt   DateTime @updatedAt
}

model Approval {
  id           String         @id @default(cuid())
  title        String
  kind         String
  automationId String?
  risk         ApprovalRisk   @default(LOW)
  preview      String
  status       ApprovalStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  decidedAt    DateTime?

  createdBy   User?   @relation("ApprovalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  decidedBy   User?   @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedById String?

  @@index([status])
  @@index([createdAt])
}

model Workflow {
  id        String   @id @default(cuid())
  name      String
  trigger   String
  condition String
  action    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  createdBy   User?   @relation("WorkflowCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  @@index([createdAt])
}

model Incident {
  id         String           @id @default(cuid())
  title      String
  severity   IncidentSeverity @default(SEV3)
  playbook   String
  stage      IncidentStage    @default(DETECTED)
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  @@index([severity])
  @@index([stage])
  @@index([createdAt])
}

model SecurityEvent {
  id        String            @id @default(cuid())
  kind      SecurityEventKind
  severity  ApprovalRisk      @default(LOW)
  path      String
  method    String
  ip        String?
  detail    String?
  createdAt DateTime          @default(now())

  @@index([kind])
  @@index([severity])
  @@index([createdAt])
}

model AgentRun {
  id           String   @id @default(cuid())
  agentId      String
  input        String
  output       String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)
  createdAt    DateTime @default(now())

  @@index([agentId])
  @@index([createdAt])
}

// ─── Digital Office: Attendance & Location ────────
// One row per employee per office-local day. Office time starts at the
// first punch-in; attendance is FINALIZED (marked complete) only when the
// employee clicks Punch Out. Location is captured at punch in/out and via
// live pings while punched in — visible to SUPER_ADMIN only.

model AttendanceDay {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          String // YYYY-MM-DD in office timezone (Asia/Kolkata)
  firstPunchIn  DateTime
  lastPunchOut  DateTime?
  status        AttendanceStatus @default(PRESENT)
  finalized     Boolean          @default(false) // attendance counts only after punch-out
  workedMinutes Int              @default(0)
  inLat         Float?
  inLng         Float?
  inAccuracy    Float?
  outLat        Float?
  outLng        Float?
  outAccuracy   Float?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([userId])
  @@index([finalized])
}

model LocationPing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lat       Float
  lng       Float
  accuracy  Float?
  kind      String   @default("live") // punch_in | live | punch_out
  date      String // YYYY-MM-DD for fast per-day filtering
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, date])
  @@index([createdAt])
}

// ─── Workforce: HR profile, tasks, leave ──────────
// An employee IS a User with role EMPLOYEE. EmployeeProfile holds the HR
// extras; WorkTask + LeaveRequest are the live workspace data.

model EmployeeProfile {
  id         String         @id @default(cuid())
  userId     String         @unique
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   String?
  type       EmploymentType @default(FULL_TIME)
  status     EmployeeStatus @default(ACTIVE)
  joinedAt   DateTime       @default(now())
  manager    String?
  salary     Int            @default(0)
  kpi        Int            @default(75)
  tools      String[]       @default([])
  workspace  String?
  notes      String?
  avatarHue  Int            @default(150)
  annual     Int            @default(18)
  sick       Int            @default(12)
  casual     Int            @default(12)
  usedAnnual Int            @default(0)
  usedSick   Int            @default(0)
  usedCasual Int            @default(0)

  // Extended HR profile (additive)
  employeeCode    String?
  departmentId    String?
  dept            Department? @relation("DeptEmployees", fields: [departmentId], references: [id], onDelete: SetNull)
  dateOfBirth     DateTime?
  gender          String?
  address         String?
  emergencyName   String?
  emergencyPhone  String?
  bloodGroup      String?
  bankName        String?
  bankAccount     String?
  ifsc            String?
  taxId           String?
  probationEndsAt DateTime?
  contractEndsAt  DateTime?
  weeklyHours     Int?
  currency        String?     @default("INR")
  payFrequency    String?     @default("MONTHLY")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
}

model WorkTask {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  project   String?
  stage     EmployeeTaskStage @default(TODO)
  priority  Priority          @default(MEDIUM)
  due       DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId])
  @@index([stage])
}

model LeaveRequest {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      LeaveType
  fromDate  DateTime
  toDate    DateTime
  days      Int
  reason    String?
  status    LeaveRequestStatus @default(PENDING)
  decidedAt DateTime?
  createdAt DateTime           @default(now())

  @@index([userId])
  @@index([status])
}

// ─── Workforce OS: departments, performance, goals, onboarding, payroll, comms ──

model Department {
  id            String            @id @default(cuid())
  name          String            @unique
  code          String?
  description   String?
  headId        String?
  head          User?             @relation("DeptHead", fields: [headId], references: [id], onDelete: SetNull)
  employees     EmployeeProfile[] @relation("DeptEmployees")
  announcements Announcement[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model PerformanceReview {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("ReviewSubject", fields: [userId], references: [id], onDelete: Cascade)
  period       String
  rating       Int
  strengths    String?
  improvements String?
  reviewerId   String?
  reviewer     User?    @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Goal {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  progress    Int        @default(0)
  status      GoalStatus @default(ACTIVE)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())

  @@index([userId])
}

model OnboardingTask {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Payslip {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month      String
  gross      Int
  deductions Int      @default(0)
  net        Int
  currency   String   @default("INR")
  notes      String?
  issuedAt   DateTime @default(now())

  @@unique([userId, month])
  @@index([userId])
}

model Announcement {
  id           String               @id @default(cuid())
  title        String
  body         String
  audience     AnnouncementAudience @default(ALL)
  departmentId String?
  department   Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?                @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())

  @@index([audience])
}

// ─── Business modules (CPQ, Orders, Campaigns, Content, PIM, Inventory, Bugs) ──

model Quotation {
  id         String    @id @default(cuid())
  number     String?
  customer   String
  subtotal   Float     @default(0)
  gstPct     Float     @default(18)
  transport  Float     @default(0)
  discount   Float     @default(0)
  total      Float     @default(0)
  validUntil DateTime?
  notes      String?
  status     String    @default("DRAFT")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Order {
  id            String   @id @default(cuid())
  customer      String
  quotationRef  String?
  amount        Float    @default(0)
  invoiceNumber String?
  paymentStatus String   @default("UNPAID")
  status        String   @default("CREATED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Campaign {
  id        String    @id @default(cuid())
  name      String
  type      String?
  channel   String?
  budget    Float     @default(0)
  spend     Float     @default(0)
  leads     Int       @default(0)
  startDate DateTime?
  endDate   DateTime?
  status    String    @default("DRAFT")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Content {
  id           String    @id @default(cuid())
  title        String
  kind         String    @default("SOCIAL")
  channel      String?
  body         String?
  scheduledFor DateTime?
  status       String    @default("DRAFT")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([kind])
  @@index([status])
  @@index([createdAt])
}

model Product {
  id        String   @id @default(cuid())
  name      String
  code      String?
  category  String?
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model InventoryItem {
  id            String   @id @default(cuid())
  name          String
  sku           String?
  location      String?
  totalStock    Int      @default(0)
  reservedStock Int      @default(0)
  sampleStock   Int      @default(0)
  reorderPoint  Int      @default(0)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Bug {
  id        String   @id @default(cuid())
  title     String
  severity  String   @default("MEDIUM")
  source    String   @default("MANUAL")
  detail    String?
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([severity])
  @@index([status])
  @@index([createdAt])
}
