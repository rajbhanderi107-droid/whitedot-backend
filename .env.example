# Database
DATABASE_URL="postgresql://user:password@localhost:5432/whitedot?schema=public"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Seed admin (used by prisma/seed.ts)
ADMIN_SEED_EMAIL="admin@whitedot.in"
ADMIN_SEED_PASSWORD="change-this-seed-password"

# Google OAuth (get from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Future: Email
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# Future: File storage
# STORAGE_PROVIDER=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
