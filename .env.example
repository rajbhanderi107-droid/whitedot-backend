# Database — points to the Postgres container (docker-compose service name = db)
DATABASE_URL="postgresql://whitedot:CHANGE_ME@db:5432/whitedot?schema=public"
DIRECT_URL="postgresql://whitedot:CHANGE_ME@db:5432/whitedot?schema=public"

# Must match POSTGRES_PASSWORD in docker-compose (used by both services)
POSTGRES_PASSWORD="CHANGE_ME"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"

# Server
PORT=4000
NODE_ENV=production
FRONTEND_URL="https://whitedotindia.in"
FRONTEND_ORIGINS="https://whitedotindia.in,https://rajbhanderi107-droid.github.io"

# Seed admin (used by prisma/seed.ts on first run)
ADMIN_SEED_EMAIL="admin@whitedot.in"
ADMIN_SEED_PASSWORD="change-this-seed-password"

# Google OAuth
GOOGLE_CLIENT_ID="689571813571-q5ctmgkmu8vt1cvgbeeubqdmabs2a7ec.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=""

# AI agents
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
